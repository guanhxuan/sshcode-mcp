{
  "name": "sshcode-mcp",
  "version": "0.1.0",
  "description": "AI 远程开发工具 - 通过 SSH 让 AI 在远程计算机上进行开发操作",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "sshcode-mcp": "./bin/sshcode.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "dependencies": {
    "ssh2": "^1.16.0",
    "commander": "^12.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
